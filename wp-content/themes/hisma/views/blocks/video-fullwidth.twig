{% macro default(data) %}
    {% import "@components/embed.twig" as _embed %}

    <div class="acf-component acf-component--video is-full">
        {{ _embed.default({
            type: data.video.0.acf_fc_layout,
            video: data.video.0.link,
            image: data.image
        }) }}
    </div>
{% endmacro %}