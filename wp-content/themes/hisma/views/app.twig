{% import "@utils/quick-links.twig" as quicklinks %}
{% import "@utils/headroom.twig" as headroom %}
{% import "@utils/footer.twig" as footer %}
{% import "@utils/scrollbar.twig" as _scrollbar %}
{# {% import "@components/alert.twig" as alert %} #}
{% import "@utils/grid-helper.twig" as gridhelper %}

{% set data_alert = get_fields('option').other_data.alert %}

<!DOCTYPE html>
<html lang="{{ get_current_language() }}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta charset="{{ site.charset }}">
		<meta name="description" content="{{ site.description }}">
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="profile" href="http://gmpg.org/xfn/11">
		{{ function('wp_head') }}
	</head>
	<body class="{% if _context._session.welcome %}welcome{% endif %}" wp-class="{{ body_class }}">
		{# QUICKLINKS - Accessibility #}
		{# {{ quicklinks.default() }} #}
		
		{# HEADER #}
		{# {{ headroom.default() }} #}

		{# MAIN #}
		<main id="swup" class="transition-fade" role="main" tabindex="-1">
			{% block app %}{% endblock %}

			{{ _scrollbar.default() }}
		</main>
		
		{# FOOTER #}
		{{ footer.default() }}

		{# ALERT #}
		{% if data_alert %}
			{{ alert.default(data_alert) }}
		{% endif %}

		{# GRID HELPER #}
		{{ gridhelper.default(app_data) }}

		{{ function('wp_footer') }}
	</body>
</html>
