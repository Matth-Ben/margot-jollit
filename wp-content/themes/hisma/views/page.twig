{% extends "app-content.twig" %}

{% import "@components/image.twig" as image %}
{% import "@components/breadcrumbs.twig" as breadcrumbs %}
{% import "@components/acf-flex-content.twig" as acf_flex_content %}

{% set data = get_fields() %}

{% block app_content %}
    <div class="Page">
        <div class="Page__cover">
            <div class="Page__cover--body">
                <div class="container">
                    <div class="Page__breadcrumbs animation--fade-up" show-element show-delay="300">
                        {{ breadcrumbs.default() }}
                    </div>
                </div>
                <div class="container">
                    <div class="grid grid-cols-6 d:grid-cols-12 gap">
                        <div class="col-span-6 d:col-span-9">
                            <h1 class="Page__title split animation--text" show-element>{{ post.title }}</h1>
                        </div>
                    </div>
                </div>
            </div>
            {% if post.thumbnail %}
                <div class="Page__thumbnail" show-element show-delay="400">
                    <div>
                        {{ image.full(post.thumbnail) }}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="Page__main">
            {{ acf_flex_content.default(data.content, data.anchor) }}
        </div>
    </div>
{% endblock %}
