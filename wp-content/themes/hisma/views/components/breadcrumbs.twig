{% macro default(data) %}
	{% set breadcrumbs = data.id ? get_breadcrumbs(data.id) : get_breadcrumbs() %}

	<div class="component component--breadcrumbs fsc gap-s">
		{% for index, item in breadcrumbs %}
			<span>
				{% include "@icons/chevron-mini.svg" %}
			</span>
			<a class="ts-label uppercase {% if loop.last %}font-medium{% endif %}" href="{{ item.url }}" aria-title="{{ item.title }}">{{ item.text|length > 40 ? item.text|slice(0,40) ~ '...' : item.text }}</a>
		{% endfor %}
	</div>
{% endmacro %}
