{% macro default(id) %}
    {% set modal_template = '@components/modalContent/modal-' ~ id ~ '.twig' %}
    
    <div id="{{ id }}-modal" class="component component__modal" role="dialog" aria-modal="true" aria-labelledby="{{id}}-modal-title">
        <div class="component__modal--wrapper">
            {% include modal_template %}
        </div>
        <div class="component__modal--overlay"></div>
    </div>
{% endmacro %}

