{% macro default(data) %}
    <a href="{{ data.url }}" target="{{ data.target }}" role="button" aria-label="{{ data.title }}" class="component component__button {{ data.class }}">
        <span>{{ data.title }}</span>
    </a>
{% endmacro %}

{% macro icon(data) %}
    {% import "@components/svg.twig" as _svg %}
    
    <a href="{{ data.url }}" target="{{ data.target }}" role="button" aria-label="{{ data.title }}" class="component component__button {{ data.class }}">
        {% if data.title %}
            <span>{{ data.title }}</span>
        {% endif %}
        {{ _svg.default(data.icon) }}
    </a>
{% endmacro %}

{% macro action(data) %}
    {% import "@components/svg.twig" as _svg %}
    
    <button class="component component__button {{ data.class }}" role="button" aria-label="{{ data.title }}">
        {% if data.title %}
            <span>{{ data.title }}</span>
        {% endif %}

        {% if data.icon %}
            {{ _svg.default(data.icon) }}
        {% endif %}        
    </button>
{% endmacro %}