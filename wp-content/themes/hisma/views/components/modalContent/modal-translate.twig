{% import "@components/svg.twig" as _svg %}

{% set languages = get_languages() %}

<div class="component component__modalContent">
    <div class="container">
        <div class="flex items-center justify-between w-full py-xxl text-light">
            {% for language in languages %}
                <a href="{{ language.url }}" class="ts-h3" aria-label="Changer la langue en {{ lang.name }}">
                    {{ language.name }}
                </a>
            {% endfor %}      
            <div>
                <button class="component__modal-fromTop--close" aria-label="Fermer la modal">{{ _svg.default('close', 24, 24) }}</button>
            </div>
        </div>
    </div>
</div>