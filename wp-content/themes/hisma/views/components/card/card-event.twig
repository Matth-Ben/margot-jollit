{% macro default(data) %}
    {% import "@components/image.twig" as _image %}

    {% set fields = function('get_fields', data) %}
    {% set thumbnail = get_image_by_id(data._thumbnail_id) %}

    <a class="component component--card-event" href="{{ fn('get_permalink', data) }}">
        <div class="flex flex-col gap-xl">
            {% if thumbnail %}
                <div class="relative aspect-[432/460]">
                    <div class="absolute top-l left-l z-10 tags">
                        <div class="tag tag--new">Nouveau</div>
                    </div>
                    {{ _image.default(thumbnail, 'aspect-[432/460]') }}
                </div>
            {% endif %}
            <div class="flex flex-col gap-l">
                <div class="flex items-center gap-l">
                    <div class="tag">Trekking</div>
                    <div class="component__text ts-cta">{{ data.post_date|date("D. j F") }}</div>
                </div>
                <div class="flex flex-col gap-l">
                    <div class="component__text ts-h4 d:pr-xl">{{ data.post_title }}</div>
                    <div class="ts-cta">Zone d’exploration</div>
                </div>
            </div>
        </div>
    </a>
{% endmacro %}
