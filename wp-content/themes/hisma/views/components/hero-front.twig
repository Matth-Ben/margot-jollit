{% macro default(data) %}
    {% import "@components/image.twig" as _image %}
    {% import "@components/button.twig" as _button %}

    {% if data %}
        <div class="component component--hero-front" show-elements>
            <div class="container relative h-full">
                <div class="grid grid-cols-6 d:grid-cols-12 items-center gap h-full">
                    <div class="col-span-5 d:col-span-8">
                        <div class="flex flex-col gap-l">
                            {% if data.homescreen.title %}
                                <h1 class="split animation--text" show-element  show-delay="300">{{ data.homescreen.title }}</h1>
                            {% endif %}

                            {% if data.homescreen.text %}
                                <div class="ts-h4 split animation--text text-white" show-element  show-delay="400">{{ data.homescreen.text }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="animation--fade-up absolute bottom-xxl" show-element show-delay="600">
                    {% if data.homescreen.button.url %}
                        {{ _button.default(data.homescreen.button) }}
                    {% endif %}
                </div>
            </div>
            
            <div class="component--hero-front__back animation--translate-up" show-element>
                {% if data.homescreen.image.url %}
                    {{ _image.default(data.homescreen.image, { aspect_ratio: 'aspect-video' }) }}
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endmacro %}