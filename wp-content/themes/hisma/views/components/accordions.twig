{% macro default(data) %}
    {% import "@components/wysiwyg.twig" as wysiwyg %}

    {% if data %}
        <div class="component component--accordions {% if data.one_by_one %}one-by-one{% endif %}">
            {% for item in data.items %}
                <div class="accordion">
                    <div class="accordion__header">
                        <div class="ts-h4">{{ item.title }}</div>
                        <span class="accordion__wrapper-svg child:w-20 child:h-20"></span>
                    </div>
                    <div class="accordion__body">
                        <div class="accordion__content">
                            {% for content in item.content %}
                                {% for c in content %}
                                    {% if c.acf_fc_layout == "wysiwyg" %}
                                        {{ wysiwyg.default(c.wysiwyg) }}
                                    {% endif %}
                                {% endfor %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}
