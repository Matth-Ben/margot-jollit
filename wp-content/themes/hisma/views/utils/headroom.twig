{% macro default() %}
    {% import "@components/svg.twig" as _svg %}
    {% import "@components/modal.twig" as _modal %}

    {% set menus = get_menus() %}
    {% set site = get_site() %}

    <header class="component component--headroom animation--translate-down" role="banner" show-element show-delay="600">
        <div class="container">
            <div class="flex items-center justify-between w-full">
                <a href="{{ get_home_url() }}" aria-label="{{ site.description }}">{{ _svg.default('logo', 135, 28) }}</a>

                <nav class="flex items-center gap-l" role="navigation" aria-label="Main Navigation">
                    {% if menus['header-secondary'] and menus['header-secondary'].items %}
                        <ul class="hidden d:flex items-center gap-xl invisible d:visible">
                            {% for item in menus['header-secondary'].items %}
                                <li class="">
                                    <a class="component--headroom__item ts-cta" href="{{ item.url }}" {% if item.target %}target="_blank"{% endif %}>{{ item.name }}</a>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    <ul class="component--headroom__buttons relative z-50 hidden d:flex items-center gap-m heading invisible d:visible">
                        <li>
                            <button class="component__button--header flex items-center justify-center w-xxl h-xxl child:w-[1.4rem] child:h-[1.6rem]">{{ _svg.default('cart', 14, 16) }}</button>
                        </li>
                        <li>
                            <button 
                                class="component__button--header flex items-center justify-center w-xxl h-xxl child:w-[1.6rem] child:h-[1.6rem] component__button--modal-fromTop"
                                data-modal="search-modal"
                                aria-expanded="false"
                                aria-haspopup="true"
                                aria-controls="search-modal"
                            >
                                {{ _svg.default('search', 16, 16) }}
                            </button>
                        </li>
                        <li>
                            <button 
                                class="component__button--header flex items-center justify-center w-xxl h-xxl component__button--modal-fromTop" 
                                data-modal="translate-modal"
                                aria-expanded="false"
                                aria-haspopup="true"
                                aria-controls="translate-modal"
                            >
                                <span class="ts-cta capitalize">{{ get_current_language() }}</span>
                            </button>
                        </li>
                    </ul>

                    <button 
                        class="component component__button component__button--modal component__menu-burger" 
                        data-modal="menu-modal"
                        aria-expanded="false"
                        aria-haspopup="true"
                        aria-controls="menu-modal"
                    >
                        <span>Menu</span>
                        <div class="component__button--burger not-active">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </button>

                    {{ _modal.default('menu') }}
                    {{ _modal.fromTop('search') }}
                    {{ _modal.fromTop('translate') }}
                    {# {% if menus['header-primary'] and menus['header-primary'].items %}
                        {% for item in menus['header-primary'].items %}
                            <div class="border-b border-secondary last:border-b-0 d:border-0 py-l d:py-0">
                                {% if item.has_child_class %}
                                    <ul class="component__menu-list flex flex-col">
                                        {% for child in item.children %}
                                            {% set target = get_field('target_blank', child) %}
                                            <li class="overflow-hidden block py-s mt-[-0.8rem]">
                                                <a class="ts-h3 uppercase inline-block" href="{{ child.url }}" {% if target %}target="_blank"{% endif %}>{{ child.name }}</a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endif %} #}
                </nav>
            </div>
        </div>
    </header>
{% endmacro %}
