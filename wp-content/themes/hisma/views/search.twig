{% extends "app-content.twig" %}

{% import "@components/breadcrumbs.twig" as breadcrumbs %}
{% import "@components/pagination.twig" as pagination %}

{% set label = {
	'news': 'Actualités',
	'formation': 'Formations',
	'offre-emploi': 'Offres d\'emploi',
	'agenda': 'Agenda',
	'page': 'Page',
 } %}

{% block app_content %}
	<div class="PageSearch container">
		<div class="PageSearch--top">
			<div class="animation--fade-up" show-element show-delay="300">
				{{ breadcrumbs.default() }}
			</div>
		</div>
		<div class="PageSearch--body">
			<div class="grid grid-cols-6 d:grid-cols-12 gap-xl d:gap-24">
				<div class="col-span-6">
					<div class="flex flex-col">
						<span class="split animation--text" show-element>Vous avez cherché</span>
						<span class="ts-h1 split animation--text" show-element>{{ search_query }}</span>
					</div>
				</div>
				<div class="col-span-6 d:pl-m d:mt-l">
					{% for p in posts %}
						<div class="PageSearch--item">
							<a class="PageSearch--item__body" href="{{ p.link }}">
								<div class="PageSearch--item__content">
									<div class="ts-h4">{{ p.title }}</div>
									<div class="ts-label uppercase">{{ label[p.post_type] }}</div>
								</div>
								<div class="PageSearch--item__button">
									<span>Voir</span>
									<span>{% include "@icons/chevron-right.svg" %}</span>
								</div>
							</a>
						</div>
					{% endfor %}
					{% if posts.pagination.pages %}
						{{ pagination.default(posts) }}
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}