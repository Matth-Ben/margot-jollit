{% extends "app-content.twig" %}

{% import "@components/breadcrumbs.twig" as breadcrumbs %}
{% import "@components/pagination.twig" as pagination %}

{% block app_content %}
	<div class="Search">
		<div class="Search__breadcrumbs">
			{{ breadcrumbs.default() }}
		</div>
		<div class="Search__main">
			<div class="Search__top">
				<div>
					<h1 class="split animation--text" show-element>{{ pll__('Recherche') }}</h1>
				</div>
			</div>
			<div class="Search__content">
				<div class="Search__informations">
					<span>Vous avez cherché</span>
					<span>{{ search_query }}</span>
				</div>
				<div class="Search__list">
					<div class="Search__posts">
						{% for p in posts %}
							<div>
								<a href="{{ p.link }}">{{ p.title }}</a>
								<p>Lorem ipsum dolor sit amet consectetur, adipisicing elit.</p>
							</div>
						{% endfor %}
					</div>
				</div>
				{% if posts.pagination.pages %}
					<div class="Search__pagination">
						{{ pagination.default(posts) }}
					</div>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}