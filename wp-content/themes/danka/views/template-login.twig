{% extends "app-content.twig" %}

{% set data = get_fields() %}

{% block app_content %}
    <div class="Page">
        <div class="Page__breadcrumbs">
            {{ breadcrumbs.default() }}
        </div>
        <div class="Page__header">
            <h1>{{ post.title }}</h1>
        </div>
        <div class="Page__content">
            {% if data.description %}
                <div>{{ fn('do_shortcode', data.description) }}</div>
            {% endif %}
        </div>
    </div>
{% endblock %}
