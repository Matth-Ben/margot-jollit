{% macro default() %}
    {% import "@components/button.twig" as button %}

    {% set data = get_fields('option') %}
    {% set museums = get_posts({
        'post_type': 'museum',
        'posts_per_page': -1,
    }) %}

    <div class="acf-component acf-component--access">
        <div id="{{ slugify(pll__('Accès')) }}" class="acf-component__anchor"></div>
        <div>
            <h2 class="split animation--text" show-element>{{ pll__('Accès') }}</h2>
        </div>
        <div>
            {# Musées #}
            {% for m in museums %}
                <div>
                    <div>
                        <span>{{ m.title }}</span>
                        <span>{{ m.practical_informations_place }}</span>
                    </div>
                    <div>
                        {% if m.practical_informations_place %}
                            <span>{{ m.practical_informations_place }}</span>
                        {% endif %}
                        {% if m.practical_informations_adress %}
                            <span>{{ m.practical_informations_adress }}</span>
                        {% endif %}
                        {% if m.practical_informations_phonenumber %}
                            <a href="tel:{{ m.practical_informations_phonenumber }}">Tél.&nbsp;{{ m.practical_informations_phonenumber }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{{ _self.default(data) }}