{% macro default(data) %}
    {% import "@components/image.twig" as image %}

    {% if data.image %}
        <div class="acf-component acf-component--image acf-component--fullscreen" show-element>
            <div parallax="1">
                {{ image.default(data.image) }}
            </div>
        </div>
    {% endif %}
{% endmacro %}

{{ _self.default(data) }}