{% macro default(data) %}
    {% import "@components/image.twig" as _image %}
    {% import "@components/button.twig" as _button %}

    <div class="block--content-2">
        <div class="grid grid-cols-12 items-stretch gap max-d:hidden">
            <div class="col-span-6 d:col-span-5 d:col-start-2 d:mb-l">
                <h2 class="italic text-gold" show-element animate-lines>{{ data.left.title }}</h2>
            </div>
            <div class="col-span-6 d:col-start-1 d:pb-[12rem]">
                <div>
                    {{ _image.default(data.left.image, { aspect_ratio: 'aspect-[664/868]' }) }}
                </div>
            </div>

            <div class="col-span-6 d:col-span-4 d:col-start-9">
                <div class="flex flex-col justify-between h-full">
                    {% if data.right.content_1 %}
                        <div class="text-gold ts-highlight" show-element animate-lines>
                            {{ data.right.content_1 }}
                        </div>
                    {% endif %}

                    <div class="grid grid-cols-4">
                        <div class="col-span-4 col-start-1">
                            <div class="flex flex-col gap-30">
                                {% if data.right.image %}
                                    <div>
                                        {{ _image.default(data.right.image, { aspect_ratio: 'aspect-[439/247]' }) }}
                                    </div>
                                {% endif %}

                                {% if data.right.content_2 %}
                                    <div show-element animate-lines>
                                        {{ data.right.content_2 }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if data.right.button.url %}
                <div class="col-span-6 d:col-span-3 d:col-start-10">
                    <div>
                        {{ _button.default({
                            'title': data.right.button.title,
                            'url': data.right.button.url,
                            'target': data.right.button.target,
                            'icon': 'chevron-right'
                        }) }}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="grid grid-cols-8 items-stretch gap gap-y-0 d:hidden">
            <div class="col-span-7 mb-xl">
                <h2 class="italic text-gold" show-element animate-lines>{{ data.left.title }}</h2>
            </div>
            
            {% if data.right.content_1 %}
                <div class="col-span-7 col-start-2 mb-l">
                    <div class="text-gold ts-highlight" show-element animate-lines>
                        {{ data.right.content_1 }}
                    </div>
                </div>
            {% endif %}

            <div class="col-span-8 col-start-1 mb-xl">
                <div>
                    {{ _image.default(data.left.image, { aspect_ratio: 'aspect-[380/500]' }) }}
                </div>
            </div>

            <div class="col-span-6 col-start-3">
                <div class="flex flex-col">
                    {% if data.right.image %}
                        <div class="mb-l">
                            {{ _image.default(data.right.image, { aspect_ratio: 'aspect-[282/223]' }) }}
                        </div>
                    {% endif %}

                    {% if data.right.content_2 %}
                        <div show-element animate-lines>
                            {{ data.right.content_2 }}
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if data.right.button.url %}
                <div class="col-span-6 d:col-span-3 d:col-start-10">
                    <div>
                        {{ _button.default({
                            'title': data.right.button.title,
                            'url': data.right.button.url,
                            'target': data.right.button.target,
                            'icon': 'chevron-right'
                        }) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endmacro %}