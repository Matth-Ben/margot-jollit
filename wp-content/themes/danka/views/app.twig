{% import "@components/quick-links.twig" as quicklinks %}
{% import "@components/headroom.twig" as headroom %}
{% import "@components/grid-helper.twig" as gridhelper %}
{% import "@components/alert.twig" as alert %}

<!DOCTYPE html>
<html lang="{{ get_current_language() }}">
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta charset="{{ site.charset }}">
		<meta name="description" content="{{ site.description }}">
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
		<meta http-equiv="X-UA-Compatible" content="IE=edge">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="profile" href="http://gmpg.org/xfn/11">
		{{ function('wp_head') }}
	</head>
	<body class="{% if _context._session.welcome %}welcome{% endif %}" wp-class="{{ body_class }}">
		{{ quicklinks.default() }}
		{% if _context._session.welcome %}
			{{ alert.default() }}
		{% endif %}
		{{ headroom.default() }}
		<main id="app" role="main" tabindex="-1" data-taxi>
			<div data-taxi-view>
				{% block app %}{% endblock %}
			</div>
		</main>
		{{ gridhelper.default(app_data) }}
		{{ function('wp_footer') }}
	</body>
</html>
