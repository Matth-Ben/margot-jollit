{% macro default(pannel_search_id) %}
    {% import "@components/button.twig" as button %}
    {% import "@components/svg.twig" as svg %}

    <form class="component-pannel-search" action="/">
        <div>
            <div>
                {{ svg.default('search') }}
                <input type="text" name="s" placeholder="{{ pll__('Votre recherche') }}" />
            </div>
            {{ button.default({title: pll__('Rechercher'), attributes: 'type="submit"', variation: 'soft'}) }}
        </div>
        {{ button.icon({icon: 'close', attributes: 'type="button" data-pannel-target="' ~ pannel_search_id ~ '" aria-expanded="false" aria-haspopup="true" aria-controls="' ~ pannel_search_id ~ '"'}) }}
    </form>
{% endmacro %}