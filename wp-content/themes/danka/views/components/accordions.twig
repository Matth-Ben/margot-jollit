{% macro default(data) %}
    {% import "@components/wysiwyg.twig" as wysiwyg %}

    {% if data %}
        <div class="component-accordions {% if data.one_by_one %}component-accordions--one-by-one{% endif %}">
            {% for item in data.items %}
                <div class="component-accordions__accordion">
                    <div class="component-accordions__accordion-header">
                        <h3>{{ item.title }}</h3>
                        <span class="component-accordions__accordion-wrapper-svg">
                            {% include "@icons/chevron-down.svg" %}
                        </span>
                    </div>
                    <div class="component-accordions__accordion-body">
                        <div class="component-accordions__accordion-content">{{ wysiwyg.default({text: item.text|raw}) }}</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}

{% macro custom(data) %}
    {% import "@components/wysiwyg.twig" as wysiwyg %}

    {% if data %}
        <div class="component-accordions component-accordions--custom {% if data.one_by_one %}one-by-one{% endif %}">
            {% for item in data.items %}
                <div class="accordion">
                    {% if not item.reverse %}
                        <button class="accordion__header">{{ item.header|raw }}</button>
                    {% endif %}
                    <div class="accordion__body">
                        <div class="accordion__content">{{ wysiwyg.default({text: item.text|raw}) }}</div>
                    </div>
                    {% if item.reverse %}
                        <button class="accordion__header">{{ item.header|raw }}</button>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endmacro %}
