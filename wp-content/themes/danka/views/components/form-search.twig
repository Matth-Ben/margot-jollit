{% macro default(data) %}
    {% import "@components/button.twig" as button %}

    <form action="get" class="component component--form-search colors-primary">
        <input type="text" name="s" placeholder="Votre recherche" value="{{ data.value }}" />
        <div class="component__buttons">
            <span class="component__button-search">
                {{ button.search({url: '', title: 'Rechercher'}) }}
            </span>
            <span class="component__button-close">
                <button type="button">
                    {% include "@icons/close.svg" %}
                </button>
            </span>
        </div>
    </form>
{% endmacro %}