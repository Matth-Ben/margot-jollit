{% import "@components/svg.twig" as _svg %}

<div class="component component__modalContent text-light">
    <div class="container">
        <div class="flex items-center justify-between gap-xxl w-full py-xl text-light">
            <form method="get" id="searchform" class="flex items-center w-full" action="{{ get_home_url() }}">
                <div class="flex flex-1 flex-col d:flex-row d:items-center gap-l">
                    <div class="flex items-center justify-center w-24 h-24">
                        {% include "@icons/search.svg" %}
                    </div>
                    <input type="text" class="component__search--field" name="s" id="s" placeholder="Votre recherche"></input>
                </div>
                <button type="submit" id="searchsubmit" class="component__button component__button--border">
                    Rechercher
                </button>
            </form>
            <div class="flex items-center justify-center w-24 h-24">
                <button class="component__modal-fromTop--close" aria-label="Fermer la modal">{{ _svg.default('close', 24, 24) }}</button>
            </div>
        </div>
    </div>
</div>