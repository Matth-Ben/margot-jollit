{% import "@components/svg.twig" as _svg %}
{% import "@components/button.twig" as button %}

{% set menus = get_menus() %}

<div class="component component__modalContent text-light w-full h-full d:pt-[14rem] px-xxl pb-xxl">
    <div class="flex flex-col justify-between h-full">
        <div class="component__menu">
            {% if menus['header-primary'] and menus['header-primary'].items %}
                <ul>
                    {% for item in menus['header-primary'].items %}
                        <li>
                            <a href="{{ item.url }}" class="component__menu--link ts-h3 border-t flex w-full py-l border-white-light">{{ item.title }}</a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
        <div class="flex items-center justify-between w-full">
            {{ button.default({'title':'Contact', 'url':'/contact/', 'target':''}) }}
        </div>
    </div>
</div>