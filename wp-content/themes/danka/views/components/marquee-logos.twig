{% macro default(data) %}
    {% import "@components/image.twig" as image %}
    {% import "@components/button.twig" as button %}
    {% import "@components/svg.twig" as svg %}

    <div class="component-marquee-logos">
        <div class="component-marquee-logos__container">
            <div>
                {% for item in data.items %}
                    {{ image.default(item) }}
                {% endfor %}
            </div>
        </div>
        <button class="component-button component-button--icon" aria-label="{{ pll__('Play/Pause') }}">
            <span class="component-button__icon">
                {{ svg.default('pause') }}
                {{ svg.default('play') }}
            </span>
        </button>
    </div>
{% endmacro %}
