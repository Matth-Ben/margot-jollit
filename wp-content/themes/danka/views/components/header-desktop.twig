{% macro default(data) %}
    {% import "@components/button.twig" as button %}
    {% import "@components/modal.twig" as modal %}
    {% import "@components/pannel.twig" as pannel %}
    {% import "@components/pannel-navigation.twig" as pannel_navigation %}
    {% import "@components/pannel-search.twig" as pannel_search %}

    {% set menus = get_menus() %}

    <div class="component-header-desktop">
        <nav>
            <a href="{{ function('get_bloginfo', 'url') }}">
                {% include "@assets/svg/logo.svg" %}
            </a>
            <div>
                {% if menus['header-primary'].items %}
                    <ul>
                        {% for item in menus['header-primary'].items %}
                            <li>
                                <a href="{{ item.url }}">{{ item.title }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                <div>
                    {{ button.icon({icon: 'cart'}) }}
                    {{ button.icon({icon: 'search', attributes: 'data-pannel-target="' ~ data.pannel_search_id ~ '" aria-expanded="false" aria-haspopup="true" aria-controls="' ~ data.pannel_search_id ~ '"'}) }}
                </div>
                {{ button.burger({title: 'Menu', attributes: 'data-pannel-target="' ~ data.pannel_navigation_id ~ '" aria-expanded="false" aria-haspopup="true" aria-controls="' ~ data.pannel_navigation_id ~ '"'}) }}
            </div>
        </nav>
    </div>

    
{% endmacro %}
