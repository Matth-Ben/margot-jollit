{% macro default(data) %}
    {% import "@components/button.twig" as button %}
    {% import "@components/svg.twig" as svg %}

    {% if data.text %}
        <div class="component--alert">
            <div class="component-alert__content">
                <div>
                    <p>{{ data.text }}</p>
                    {% if data.button.title and data.button.url %}
                        {{ button.simple({
                            title: data.button.title,
                            url: data.button.url,
                            target: data.button.target,
                            icon: 'arrow-right',
                        }) }}
                    {% endif %}
                </div>
                <button aria-label="{{ pll__('Fermer') }}">
                    {{ svg.default('close') }}
                </button>
            </div>
        </div>
    {% endif %}
{% endmacro %}