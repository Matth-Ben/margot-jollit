{% macro default() %}
    {% import "@components/image.twig" as _image %}

    {% set menus = get_menus() %}
    {% set data = get_fields('option') %}

    <footer class="component-footer">
        <div>
            <div>
                <p>
                    Danka<br>
                    24 avenue Joannes Masset<br>
                    69009 Lyon<br>
                    Tél. 09 54 10 02 54
                </p>
                <div>
                    <a href="#0">FB</a>
                    <a href="#0">X</a>
                </div>
            </div>
            <div>
                {% if menus['header-primary'].items %}
                    <ul>
                        {% for item in menus['header-primary'].items %}
                            <li><a href="{{ item.url }}" target="{{ item.target }}">{{ item.title }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if menus['header-secondary'].items %}
                    <ul>
                        {% for item in menus['header-secondary'].items %}
                            <li><a href="{{ item.url }}" target="{{ item.target }}">{{ item.title }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>
        <div>
            {% include "@assets/svg/logo.svg" %}
            {% if menus['mobile'].items %}
                <ul>
                    {% for item in menus['mobile'].items %}
                        <li><a href="{{ item.url }}" target="{{ item.target }}">{{ item.title }}</a></li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </footer>
{% endmacro %}