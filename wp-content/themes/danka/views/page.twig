{% extends "app-content.twig" %}

{% import "@components/image.twig" as image %}
{% import "@components/acf-flex-content.twig" as acf_flex_content %}
{% import "@components/button.twig" as button %}
{% import "@components/breadcrumbs.twig" as breadcrumbs %}

{% set data = get_fields() %}

{% block app_content %}
    <div class="Page">
        <div class="Page__header max-d:hidden">
            <div class="container relative">
                <div class="grid grid-cols-8 d:grid-cols-12 relative">
                    <div class="col-span-8 d:col-span-11 d:col-start-2 pt-173">
                        <h1 class="text-gold" show-element animate-lines>{{ data.title ? data.title : post.title }}</h1>
                    </div>

                    {% if post.thumbnail %}
                        <div class="Page__thumbnail">
                            <div>
                                {{ image.default(post.thumbnail, {'aspect_ratio' : 'aspect-[326/435]'}) }}
                            </div>
                        </div>
                    {% endif %}
                </div>

                {% if data.description %}
                    <div class="absolute left-0 -bottom-20 w-full">
                        <div class="grid grid-cols-8 d:grid-cols-12 relative">
                            <div class="col-span-3 d:col-start-9">
                                <div show-element animate-lines>{{ data.description }}</div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="Page__header d:hidden">
            <div class="container relative">
                <div class="grid grid-cols-8 d:grid-cols-12 relative">
                    {% if post.thumbnail %}
                        <div class="Page__thumbnail col-span-8">
                            <div>
                                {{ image.default(post.thumbnail, {'aspect_ratio' : 'aspect-[326/435]'}) }}
                            </div>
                        </div>
                    {% endif %}

                    <div class="col-span-8 mt-m">
                        <h1 class="text-gold" show-element animate-lines>{{ data.title ? data.title : post.title }}</h1>
                    </div>
                </div>

                {% if data.description %}
                    <div class="grid grid-cols-8 mt-m">
                        <div class="col-span-6 col-start-3">
                            <div show-element animate-lines>{{ data.description }}</div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
        
        <div class="Page__content">
            {{ acf_flex_content.default(data.content) }}
        </div>
    </div>
{% endblock %}
