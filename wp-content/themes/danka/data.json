{
    "breakpoints": {
        "m": 768,
        "l": 1024,
        "xl": 1280,
        "xxl": 1440
    },
    "breakpointDesktop": "l",
    "rem": {
        "default": "10px",
        "xxl": "scale"
    },
    "margins": {
        "default": 1.6,
        "m": 5
    },
    "gaps": {
        "default": 1.2,
        "m": 1.2
    },
    "spacings": {
        "s": 0.4,
        "m": 2,
        "l": 5,
        "xl": 8,
        "xxl": 15,
        "desktop": {
            "s": 2,
            "m": 5,
            "l": 8,
            "xl": 10,
            "xxl": 20
        }
    },
    "colors": {
        "dark": "#000",
        "light": "#fff",
        "primary": "#304ACF",
        "gold": "#A58561",
        "light-grey": "#EEEAE0",
        "cta-light": "#EEEAE04D",
        "cta-dark": "#A585614D"
    },
    "fonts": {
        "default": {
            "name": "PP Mori",
            "serif": "sans-serif"
        },
        "heading": {
            "name": "PP Eiko",
            "serif": "sans-serif"
        }
    },
    "textStyles": {
        "h1": {
            "font-size": "5.5rem",
            "line-height": "8rem",
            "font-weight": "300",
            "font-family": "heading",
            "text-transform": "uppercase"
        },
        "h2": {
            "font-size": "3.5rem",
            "line-height": "5rem",
            "font-weight": "300",
            "font-family": "heading"
        },
        "h2-italic": {
            "font-size": "4rem",
            "line-height": "6rem",
            "font-weight": "300",
            "font-family": "heading",
            "font-style": "italic"
        },
        "h3": {
            "font-size": "3.5rem",
            "line-height": "4.5rem",
            "font-weight": "400",
            "font-family": "heading"
        },
        "titles": {
            "font-family": "heading"
        },
        "headline": {
            "font-size": "1.5rem",
            "line-height": "1",
            "font-weight": "400",
            "font-family": "default"
        },
        "highlight": {
            "font-size": "2.5rem",
            "line-height": "1",
            "font-weight": "400",
            "font-family": "default"
        },
        "suptitle": {
            "font-size": "1.8rem",
            "line-height": "1",
            "font-weight": "400",
            "font-family": "default"
        },
        "body": {
            "font-size": "1.4rem",
            "line-height": "2.4rem",
            "font-weight": "300",
            "font-family": "default"
        },
        "cta": {
            "font-size": "1.6rem",
            "line-height": "3rem",
            "font-weight": "300"
        },
        "bold": {
            "font-weight": "600"
        },
        "desktop": {
            "h1": {
                "font-size": "15rem",
                "line-height": "1"
            },
            "h2": {
                "font-size": "6rem",
                "line-height": "1"
            }
        }
    },
    "radius": 0,
    "maxColumns": {
        "default": 6,
        "m": 8,
        "l": 12
    },
    "lists": {
        "default": {
            "s": 1,
            "m": 4
        },
        "secondary": {
            "s": 1,
            "m": 3
        }
    },
    "transitions": {
        "default": {
            "duration": 400,
            "timing": "ease"
        },
        "secondary": {
            "duration": 800,
            "timing": "ease-in-out"
        }
    },
    "custom": {
        "pannel-width": {
            "default": "100%",
            "desktop": "calc(var(--spacing-col-5) + var(--margin))"
        }
    }
}